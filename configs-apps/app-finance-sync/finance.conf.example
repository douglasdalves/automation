# Copie para /etc/finance-backup.conf e ajuste os valores do seu ambiente.
# Este arquivo é lido pelo script de backup da aplicação financeira.

# Nome do remote configurado no rclone, por exemplo: "onedrive" ou "gdrive"
RCLONE_REMOTE="googledrive"

# Opcional: caminho do rclone.conf se o script executado como root nao deve usar
# a configuracao padrao de /root/.config/rclone/rclone.conf.
# RCLONE_CONFIG="/etc/rclone/rclone.conf"

# Pasta dentro do remote onde os backups do financeiro serão enviados
RCLONE_PATH="homelab-backups/finance"

# Configuração opcional do container e do diretório local de backup
CONTAINER_NAME="dc-finance-api"
CONTAINER_DATABASE="/app/finance.db"
BACKUP_DIR="/var/backups/finance"

# Quantos dias manter backups remotos antigos
RETENTION_DAYS="30"
