mkdir ~/mcp-health
cd ~/mcp-health

python3 -m venv .venv
source .venv/bin/activate

pip install mcp psutil

pip freeze > requirements.txt

pip show mcp
pip freeze | grep mcp

#---------------------------------
vcgencmd measure_temp

uptime = psutil.boot_time()

#----------------------------------
python test_health.py

python server.py

#---------------------------------

MCP inspector no VS code
http://localhost:5080/mcp


#------------------------------------


sudo nano /etc/systemd/system/homelab-mcp.service
sudo systemctl daemon-reload
sudo systemctl enable homelab-mcp
sudo systemctl start homelab-mcp
sudo systemctl status homelab-mcp
journalctl -u homelab-mcp -f

sudo systemctl restart homelab-mcp

# Permitir que o usuario do servico execute o deploy sem prompt de senha
sudo visudo -f /etc/sudoers.d/homelab-deploy
