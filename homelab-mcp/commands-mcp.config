mkdir ~/mcp-health
cd ~/mcp-health

python3 -m venv .venv
source .venv/bin/activate

pip install mcp psutil

pip freeze > requirements.txt

pip show mcp
pip freeze | grep mcp

#---------------------------------
vcgencmd measure_temp

uptime = psutil.boot_time()

#----------------------------------
python test_health.py

python server.py

